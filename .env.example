APP_NAME="AI CRM API"
APP_VERSION="0.1.0"
DEBUG=true
DATABASE_URL="sqlite+aiosqlite:///./ai_crm_phase1.db"
API_V1_PREFIX="/api/v1"
AUTH_SECRET_KEY="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_ISSUER="ai-crm-api"
AUTH_TOKEN_TTL_MINUTES=60
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
INTEGRATION_LEASE_SECONDS=60
FIXTURE_WEBHOOK_MAX_AGE_SECONDS=300
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_LEASE_SECONDS=60
JOB_DEFAULT_LEASE_SECONDS=60
JOB_DEFAULT_TIMEOUT_SECONDS=300
JOB_MAX_BACKOFF_SECONDS=3600
AI_PROVIDER_KEY=fixture
AI_MODEL_KEY=fixture-text-v1
AI_CONFIG_VERSION=phase6-local-v1
AI_PROMPT_CATALOG_VERSION=phase6-v1
AI_TIMEOUT_SECONDS=10
AI_MAX_ATTEMPTS=2
AI_RETRY_DELAY_SECONDS=0.05
AI_MAX_OUTPUT_CHARS=12000
AI_COST_PER_1K_INPUT_MICROS=0
AI_COST_PER_1K_OUTPUT_MICROS=0
ACTION_DEFAULT_EXPIRATION_HOURS=24
ACTION_TIMEOUT_SECONDS=30
ACTION_MAX_ATTEMPTS=3
PROACTIVE_INACTIVE_OPPORTUNITY_DAYS=30
PROACTIVE_ALERT_SUPPRESSION_MINUTES=60
OBSERVABILITY_RETENTION_DAYS=90
WORKER_ENABLED=false
WORKER_POLL_SECONDS=5
WORKER_BATCH_SIZE=10
PROACTIVE_CHECK_INTERVAL_SECONDS=300
INTEGRATION_SYNC_INTERVAL_SECONDS=900
AGENT_MAX_DEPTH_CAP=3
AGENT_MAX_FANOUT_CAP=3
AGENT_TOKEN_BUDGET_CAP=200000
AGENT_STEP_BUDGET_CAP=50
AGENT_SIDE_EFFECT_BUDGET_CAP=10
AGENT_MAX_RUN_HOURS=24
AGENT_REPEATED_FAILURE_THRESHOLD=2
AGENT_COST_PER_1K_TOKENS_MICROS=0
# Comma-separated platform-wide kill switches: ai,workflows,connectors,agents
DISABLED_CAPABILITIES=
# Named owner reported on every SLO
SLO_OWNER=platform-oncall
