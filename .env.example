APP_NAME="AI CRM API"
APP_VERSION="0.1.0"
DEBUG=true
DATABASE_URL="sqlite+aiosqlite:///./ai_crm_phase1.db"
API_V1_PREFIX="/api/v1"
AUTH_SECRET_KEY="replace-this-local-development-secret"
AUTH_ISSUER="ai-crm-api"
AUTH_TOKEN_TTL_MINUTES=60
AUTO_CREATE_TABLES=true
SEED_DEMO_DATA=true
INTEGRATION_LEASE_SECONDS=60
FIXTURE_WEBHOOK_MAX_AGE_SECONDS=300
